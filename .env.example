# Copiá este archivo como .env. No subas .env a GitHub.
LABURITO_PORT=8080

# YouTube Data API v3 OAuth (opcional hasta conectar el canal)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Opcional en el modo local: el volumen ./data ya conserva los archivos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=laburito-private-backups
